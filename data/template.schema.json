{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/yantra-app/awesome-workflow-templates/main/data/template.schema.json",
 "title": "Yantra workflow template",
 "description": "One template file: the workflow in the shape `cdecli workflow create-from-json` accepts, plus the `template` metadata block. Generated by scripts/convert-n8n.mjs (or hand-authored).",
 "type": "object",
 "required": [
  "name",
  "workflowSlug",
  "description",
  "isPublic",
  "nodes",
  "edges",
  "template"
 ],
 "properties": {
  "name": {
   "type": "string",
   "minLength": 1
  },
  "workflowSlug": {
   "type": "string",
   "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "description": {
   "type": "string"
  },
  "isPublic": {
   "type": "boolean"
  },
  "nodes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "nodeId",
     "actorId",
     "type",
     "label",
     "color",
     "position",
     "size"
    ],
    "properties": {
     "nodeId": {
      "type": "string",
      "pattern": "^node_[a-z0-9]{6,}$"
     },
     "actorId": {
      "type": "string",
      "pattern": "^actor_[a-z0-9]{6,}$"
     },
     "type": {
      "enum": [
       "NodeStart",
       "NodeEnd",
       "NodeCron",
       "NodeCdeWebhookTrigger",
       "NodeCdeConnector",
       "NodeTransform",
       "NodeHttpRequest",
       "NodeBranch",
       "NodeIterator",
       "NodeLoop",
       "NodeRepeatUntil",
       "NodeUpdateContext",
       "NodeSync",
       "NodeChatModel",
       "NodeLlmChain",
       "NodeCdecliAgent",
       "NodeWorkflowConfigs"
      ]
     },
     "label": {
      "type": "string",
      "minLength": 1
     },
     "color": {
      "type": "string",
      "minLength": 1
     },
     "position": {
      "type": "object",
      "required": [
       "x",
       "y"
      ],
      "properties": {
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       }
      }
     },
     "size": {
      "type": "object",
      "required": [
       "width",
       "height"
      ],
      "properties": {
       "width": {
        "type": "number"
       },
       "height": {
        "type": "number"
       }
      }
     },
     "inputs": {
      "type": "object"
     }
    }
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "source",
     "target",
     "sourceOutput",
     "targetInput",
     "sourceNodeType",
     "targetNodeType"
    ],
    "properties": {
     "source": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "sourceOutput": {
      "type": "string"
     },
     "targetInput": {
      "type": "string"
     },
     "sourceNodeType": {
      "enum": [
       "NodeStart",
       "NodeEnd",
       "NodeCron",
       "NodeCdeWebhookTrigger",
       "NodeCdeConnector",
       "NodeTransform",
       "NodeHttpRequest",
       "NodeBranch",
       "NodeIterator",
       "NodeLoop",
       "NodeRepeatUntil",
       "NodeUpdateContext",
       "NodeSync",
       "NodeChatModel",
       "NodeLlmChain",
       "NodeCdecliAgent",
       "NodeWorkflowConfigs"
      ]
     },
     "targetNodeType": {
      "enum": [
       "NodeStart",
       "NodeEnd",
       "NodeCron",
       "NodeCdeWebhookTrigger",
       "NodeCdeConnector",
       "NodeTransform",
       "NodeHttpRequest",
       "NodeBranch",
       "NodeIterator",
       "NodeLoop",
       "NodeRepeatUntil",
       "NodeUpdateContext",
       "NodeSync",
       "NodeChatModel",
       "NodeLlmChain",
       "NodeCdecliAgent",
       "NodeWorkflowConfigs"
      ]
     }
    }
   }
  },
  "template": {
   "type": "object",
   "required": [
    "schemaVersion",
    "category",
    "connectors",
    "nodeTypes",
    "comparison",
    "source",
    "tier",
    "blockers",
    "setup",
    "conversion"
   ],
   "properties": {
    "schemaVersion": {
     "const": 2
    },
    "category": {
     "type": "string"
    },
    "categoryLabel": {
     "type": "string"
    },
    "department": {
     "type": "string"
    },
    "connectors": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "setupVars": {
     "type": "array",
     "description": "Values the person supplies before import; written into the Workflow Configs initialContext.",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label",
       "type",
       "usedBy"
      ],
      "additionalProperties": false,
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "description": "initialContext key; steps read it as {{key}}"
       },
       "label": {
        "type": "string"
       },
       "type": {
        "enum": [
         "id",
         "email",
         "channel",
         "url",
         "text"
        ]
       },
       "example": {
        "type": "string"
       },
       "usedBy": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "setupSecrets": {
     "type": "array",
     "description": "Workflow secrets the steps read through {\"$workflowSecret\": KEY} references; never in the JSON.",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label",
       "headerFormat",
       "contextKey",
       "usedBy"
      ],
      "additionalProperties": false,
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$",
        "description": "workflow secret key, added in the workflow editor Secrets panel"
       },
       "label": {
        "type": "string"
       },
       "host": {
        "type": "string"
       },
       "headerFormat": {
        "type": "string",
        "description": "where the secret goes, e.g. Authorization: Bearer <secret>"
       },
       "contextKey": {
        "type": "string",
        "description": "initialContext key holding {\"$workflowSecret\": key}"
       },
       "usedBy": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "oauth": {
        "type": "boolean",
        "description": "an OAuth access token that expires"
       }
      }
     }
    },
    "activation": {
     "type": "string",
     "description": "Command to run after import, e.g. cdecli cron activate <slug> for scheduled templates."
    },
    "nodeTypes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "comparison": {
     "type": "object",
     "required": [
      "n8nSteps",
      "yantraSteps"
     ],
     "properties": {
      "n8nSteps": {
       "type": "integer"
      },
      "yantraSteps": {
       "type": "integer"
      },
      "foldedHelpers": {
       "type": "array"
      }
     }
    },
    "source": {
     "type": "object",
     "required": [
      "path"
     ],
     "properties": {
      "repo": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "commit": {
       "type": "string"
      },
      "n8nName": {
       "type": "string"
      }
     }
    },
    "tier": {
     "enum": [
      "verified",
      "ready",
      "experimental"
     ]
    },
    "blockers": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "code",
       "detail"
      ],
      "additionalProperties": false,
      "properties": {
       "code": {
        "enum": [
         "missing-required-param",
         "http-auth-missing",
         "placeholder",
         "upstream-literal-id",
         "personal-email",
         "secret-as-input",
         "signature-verification",
         "webhook-registration",
         "trigger-replaced",
         "loop-flattened",
         "hard-approximation",
         "action-pending-publish",
         "unimplemented-action",
         "unmapped-node"
        ]
       },
       "node": {
        "type": "string"
       },
       "detail": {
        "type": "string"
       }
      }
     }
    },
    "setup": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "aliases": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "path"
      ],
      "properties": {
       "path": {
        "type": "string"
       },
       "source": {
        "type": "object"
       }
      }
     }
    },
    "conversion": {
     "type": "object",
     "required": [
      "tool",
      "status"
     ],
     "properties": {
      "tool": {
       "enum": [
        "scripts/convert-n8n.mjs",
        "hand"
       ]
      },
      "status": {
       "enum": [
        "ready",
        "needs-setup",
        "partial"
       ]
      },
      "coverage": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "unmapped": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "node",
         "type"
        ]
       }
      },
      "approximate": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "node",
         "n8n"
        ],
        "properties": {
         "node": {
          "type": "string"
         },
         "n8n": {
          "type": "string"
         },
         "action": {
          "type": "string"
         },
         "soft": {
          "type": "boolean"
         },
         "reason": {
          "type": "string",
          "description": "Why the mapping is not faithful; the quality gate appends it to the blocker detail."
         },
         "blocker": {
          "enum": [
           "missing-required-param",
           "http-auth-missing",
           "placeholder",
           "upstream-literal-id",
           "personal-email",
           "secret-as-input",
           "signature-verification",
           "webhook-registration",
           "trigger-replaced",
           "loop-flattened",
           "hard-approximation",
           "action-pending-publish",
           "unimplemented-action",
           "unmapped-node"
          ]
         }
        }
       }
      },
      "folded": {
       "type": "array"
      },
      "removedEdges": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "from",
         "to"
        ]
       }
      },
      "loopPolicy": {
       "enum": [
        "flattened",
        "flattened-safe",
        "native"
       ]
      },
      "triggers": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "node",
         "type",
         "as"
        ],
        "properties": {
         "node": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "as": {
          "enum": [
           "NodeStart",
           "NodeCron",
           "NodeCdeWebhookTrigger"
          ]
         }
        }
       }
      },
      "hints": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "nodes": {
     "type": "object"
    }
   }
  }
 }
}
