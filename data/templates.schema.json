{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/yantra-app/awesome-workflow-templates/main/data/templates.schema.json",
 "title": "Yantra workflow template index (templates.json)",
 "description": "Generated by scripts/build-index.mjs. `tier` is the quality verdict; `status` is kept for older consumers (ready when tier is ready or verified, else needs-setup).",
 "type": "object",
 "required": [
  "$schema",
  "generatedAt",
  "upstream",
  "count",
  "tiers",
  "status",
  "categories",
  "templates",
  "aliases"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "generatedAt": {
   "type": "string"
  },
  "upstream": {
   "type": "object",
   "required": [
    "repo",
    "commit"
   ]
  },
  "count": {
   "type": "integer"
  },
  "tiers": {
   "type": "object",
   "additionalProperties": {
    "type": "integer"
   }
  },
  "status": {
   "type": "object",
   "additionalProperties": {
    "type": "integer"
   }
  },
  "blockers": {
   "type": "object",
   "additionalProperties": {
    "type": "integer"
   }
  },
  "comparison": {
   "type": "object"
  },
  "categories": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "slug",
     "label",
     "count"
    ]
   }
  },
  "aliases": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   },
   "description": "Old template path -> canonical path (duplicates merged)."
  },
  "templates": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "description",
     "category",
     "connectors",
     "tier",
     "status",
     "blockers",
     "setup",
     "path"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "category": {
      "type": "string"
     },
     "categoryLabel": {
      "type": "string"
     },
     "department": {
      "type": "string"
     },
     "connectors": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "nodeTypes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "nodeCount": {
      "type": "integer"
     },
     "steps": {
      "type": "object",
      "properties": {
       "n8n": {
        "type": "integer"
       },
       "yantra": {
        "type": "integer"
       }
      }
     },
     "foldedHelpers": {
      "type": "integer"
     },
     "handAuthored": {
      "type": "boolean"
     },
     "tier": {
      "enum": [
       "verified",
       "ready",
       "experimental"
      ]
     },
     "status": {
      "enum": [
       "ready",
       "needs-setup",
       "partial"
      ]
     },
     "blockers": {
      "type": "array",
      "items": {
       "enum": [
        "missing-required-param",
        "http-auth-missing",
        "placeholder",
        "upstream-literal-id",
        "personal-email",
        "secret-as-input",
        "signature-verification",
        "webhook-registration",
        "trigger-replaced",
        "loop-flattened",
        "hard-approximation",
        "action-pending-publish",
        "unimplemented-action",
        "unmapped-node"
       ]
      }
     },
     "setup": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "coverage": {
      "type": [
       "number",
       "null"
      ]
     },
     "aliases": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "path": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+\\.json$"
     },
     "source": {
      "type": "string"
     }
    }
   }
  }
 }
}
