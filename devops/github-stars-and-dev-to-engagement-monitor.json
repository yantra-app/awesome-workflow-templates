      "inputs": {
        "mode": "jsCode",
        "jsCode": "const ctx = {{ctx}};\nfunction responseBody(step, label) {\n  let body = ctx.steps?.[step]?.body;\n  if (typeof body === 'string') {\n    try { body = JSON.parse(body); } catch { throw new Error(label + ' returned invalid JSON'); }\n  }\n  if (!body || typeof body !== 'object' || Array.isArray(body)) {\n    throw new Error(label + ' response is missing. Run the whole workflow. Available steps: ' + Object.keys(ctx.steps || {}).join(', '));\n  }\n  return body;\n}\nfunction repoStats(step, label) {\n  const body = responseBody(step, label);\n  const fields = ['stargazers_count', 'forks_count', 'open_issues_count'];\n  if (!fields.every(key => typeof body[key] === 'number')) throw new Error(label + ' response does not contain repository metrics');\n  return { stars: body.stargazers_count, forks: body.forks_count, open_issues: body.open_issues_count };\n}\nconst article = responseBody('http_6482480ac8', 'dev.to Article 1');\nif (typeof article.positive_reactions_count !== 'number' || typeof article.comments_count !== 'number') throw new Error('dev.to response does not contain engagement metrics');\nreturn {\n  checked_at: new Date().toISOString(),\n  repo1: repoStats('http_344b1c3a84', 'GitHub Repo 1'),\n  repo2: repoStats('http_3d1e9b2318', 'GitHub Repo 2'),\n  article1: { reactions: article.positive_reactions_count, comments: article.comments_count }\n};"
      }
    },
