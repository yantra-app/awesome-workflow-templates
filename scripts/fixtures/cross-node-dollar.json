{
  "name": "fixture-cross-node-dollar",
  "nodes": [
    { "name": "Start", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {} },
    {
      "name": "Vars",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [200, 0],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "1", "name": "host", "value": "https://example.com", "type": "string" }
          ]
        }
      }
    },
    {
      "name": "HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Vars').json.host }}/api"
      }
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Vars", "type": "main", "index": 0 }]] },
    "Vars": { "main": [[{ "node": "HTTP", "type": "main", "index": 0 }]] }
  }
}
