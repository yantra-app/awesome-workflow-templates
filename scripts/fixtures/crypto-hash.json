{
 "name": "fixture-crypto-hash",
 "nodes": [
  {
   "name": "Start",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ],
   "parameters": {}
  },
  {
   "name": "Name",
   "type": "n8n-nodes-base.set",
   "typeVersion": 1,
   "position": [
    220,
    0
   ],
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "name": "name",
       "value": "={{ $json.name }}",
       "type": "string"
      }
     ]
    }
   }
  },
  {
   "name": "Hash name",
   "type": "n8n-nodes-base.crypto",
   "typeVersion": 1,
   "position": [
    440,
    0
   ],
   "parameters": {
    "value": "={{ $json.name.toLowerCase().trim() }}",
    "dataPropertyName": "hash"
   }
  }
 ],
 "connections": {
  "Start": {
   "main": [
    [
     {
      "node": "Name",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Name": {
   "main": [
    [
     {
      "node": "Hash name",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}
