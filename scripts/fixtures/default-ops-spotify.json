{
  "name": "fixture-default-ops-spotify",
  "nodes": [
    {
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "name": "Add song",
      "type": "n8n-nodes-base.spotify",
      "parameters": {
        "id": "={{ $json.uri }}"
      },
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Get Tracks",
      "type": "n8n-nodes-base.spotify",
      "parameters": {
        "resource": "library",
        "returnAll": true
      },
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Spotify",
      "type": "n8n-nodes-base.spotify",
      "parameters": {
        "resource": "playlist",
        "id": "={{ $json.playlist }}",
        "trackID": "={{ $json.track }}"
      },
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Add song",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add song": {
      "main": [
        [
          {
            "node": "Get Tracks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Tracks": {
      "main": [
        [
          {
            "node": "Spotify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
