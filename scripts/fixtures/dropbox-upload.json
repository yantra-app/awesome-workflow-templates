{
 "name": "fixture-dropbox-upload",
 "nodes": [
  {
   "name": "Start",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ],
   "parameters": {}
  },
  {
   "name": "Render",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 1,
   "position": [
    220,
    0
   ],
   "parameters": {
    "url": "={{ $json.videoUrl }}",
    "options": {}
   }
  },
  {
   "name": "Dropbox",
   "type": "n8n-nodes-base.dropbox",
   "typeVersion": 1,
   "position": [
    440,
    0
   ],
   "parameters": {
    "path": "=/videos/{{ $json.name }}.mp4",
    "binaryData": true,
    "overwrite": true
   }
  }
 ],
 "connections": {
  "Start": {
   "main": [
    [
     {
      "node": "Render",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Render": {
   "main": [
    [
     {
      "node": "Dropbox",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}
