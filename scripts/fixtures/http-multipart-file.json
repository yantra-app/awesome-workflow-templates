{
 "name": "fixture-http-multipart-file",
 "nodes": [
  {
   "name": "Start",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ],
   "parameters": {}
  },
  {
   "name": "Download PDF",
   "type": "n8n-nodes-base.googleDrive",
   "typeVersion": 1,
   "position": [
    220,
    0
   ],
   "parameters": {
    "operation": "download",
    "fileId": {
     "__rl": true,
     "mode": "id",
     "value": "={{ $json.fileId }}"
    }
   }
  },
  {
   "name": "Upload to LlamaParse",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 1,
   "position": [
    440,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "https://api.cloud.llamaindex.ai/api/parsing/upload",
    "sendBody": true,
    "contentType": "multipart-form-data",
    "bodyParameters": {
     "parameters": [
      {
       "name": "language",
       "value": "en"
      },
      {
       "parameterType": "formBinaryData",
       "name": "file",
       "inputDataFieldName": "data"
      }
     ]
    },
    "options": {}
   }
  }
 ],
 "connections": {
  "Start": {
   "main": [
    [
     {
      "node": "Download PDF",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Download PDF": {
   "main": [
    [
     {
      "node": "Upload to LlamaParse",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}
