{
 "name": "fixture-http-raw-body",
 "nodes": [
  {
   "name": "Start",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ],
   "parameters": {}
  },
  {
   "name": "Notify",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 1,
   "position": [
    220,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "https://ntfy.sh/alerts-topic",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Title",
       "value": "Daily summary"
      },
      {
       "name": "Content-Type",
       "value": "text/plain; charset=utf-8"
      }
     ]
    },
    "sendBody": true,
    "contentType": "raw",
    "rawContentType": "text/plain",
    "body": "={{ $json.message }}",
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     },
     "timeout": 10000
    }
   }
  }
 ],
 "connections": {
  "Start": {
   "main": [
    [
     {
      "node": "Notify",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}
