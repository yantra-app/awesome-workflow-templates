{
  "name": "fixture-openai-tts-telegram",
  "nodes": [
    { "name": "Start", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {} },
    { "name": "Speak story", "type": "@n8n/n8n-nodes-langchain.openAi", "typeVersion": 1.5, "position": [220, 0], "parameters": { "resource": "audio", "input": "={{ $json.story }}", "voice": "fable", "options": {} } },
    { "name": "Send audio", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [440, 0], "parameters": { "chatId": "={{ $json.chatId }}", "operation": "sendAudio", "binaryData": true, "additionalFields": { "caption": "The end" } } }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Speak story", "type": "main", "index": 0 }]] },
    "Speak story": { "main": [[{ "node": "Send audio", "type": "main", "index": 0 }]] }
  }
}
