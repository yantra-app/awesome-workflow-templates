    "operation": "sendDocument",
    "chatId": "={{ $json.chatId }}",
    "binaryData": true,
    "binaryPropertyName": "pdf_doc",
    "additionalFields": {
     "caption": "Your resume"
    }
   }
  }
 ],
 "connections": {
