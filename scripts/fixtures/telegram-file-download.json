{
 "name": "fixture-telegram-file-download",
 "nodes": [
  {
   "name": "Start",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ],
   "parameters": {}
  },
  {
   "name": "Download image",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 1,
   "position": [
    220,
    0
   ],
   "parameters": {
    "url": "={{ $json.imageUrl }}",
    "options": {}
   }
  },
  {
   "name": "Send photo",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1,
   "position": [
    440,
    0
   ],
   "parameters": {
    "operation": "sendPhoto",
    "chatId": "={{ $json.chatId }}",
    "binaryData": true,
    "additionalFields": {
     "caption": "Here it is"
    }
   }
  }
 ],
 "connections": {
  "Start": {
   "main": [
    [
     {
      "node": "Download image",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Download image": {
   "main": [
    [
     {
      "node": "Send photo",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}
