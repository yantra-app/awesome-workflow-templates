{
  "name": "fixture-telegram-voice-transcribe",
  "nodes": [
    { "name": "Telegram Trigger", "type": "n8n-nodes-base.telegramTrigger", "typeVersion": 1.1, "position": [0, 0], "parameters": { "updates": ["message"] } },
    { "name": "Download voice", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [220, 0], "parameters": { "resource": "file", "fileId": "={{ $json.message.voice.file_id }}" } },
    { "name": "Transcribe", "type": "@n8n/n8n-nodes-langchain.openAi", "typeVersion": 1.5, "position": [440, 0], "parameters": { "resource": "audio", "operation": "transcribe", "options": {} } }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Download voice", "type": "main", "index": 0 }]] },
    "Download voice": { "main": [[{ "node": "Transcribe", "type": "main", "index": 0 }]] }
  }
}
