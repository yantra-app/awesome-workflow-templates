{
 "name": "fixture-transcribe-drive",
 "nodes": [
  {
   "name": "Start",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ],
   "parameters": {}
  },
  {
   "name": "Get recording",
   "type": "n8n-nodes-base.googleDrive",
   "typeVersion": 1,
   "position": [
    220,
    0
   ],
   "parameters": {
    "operation": "download",
    "fileId": {
     "__rl": true,
     "mode": "id",
     "value": "={{ $json.fileId }}"
    }
   }
  },
  {
   "name": "Transcribe",
   "type": "@n8n/n8n-nodes-langchain.openAi",
   "typeVersion": 1,
   "position": [
    440,
    0
   ],
   "parameters": {
    "resource": "audio",
    "operation": "transcribe",
    "options": {
     "language": "de"
    }
   }
  }
 ],
 "connections": {
  "Start": {
   "main": [
    [
     {
      "node": "Get recording",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Get recording": {
   "main": [
    [
     {
      "node": "Transcribe",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}
